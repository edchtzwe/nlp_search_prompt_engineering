{
  "name": "nlp-video-search-prototype",
  "private": true,
  "version": "0.1.0",
  "description": "Natural-language video search and orchestration prototype using LLMs and vector embeddings.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "start": "node dist/index.js",
    "migrate:create": "node-pg-migrate create --sql -- migration",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:redo": "node-pg-migrate redo",
    "migrate:reset": "node-pg-migrate reset",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:smoke": "jest tests/health-checks.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.13",
    "@types/node-pg-migrate": "^2.3.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.13.0",
    "globals": "^17.3.0",
    "jest": "^30.2.0",
    "kanel": "^3.16.0",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.55.0",
    "vite": "^7.2.4"
  },
  "dependencies": {
    "@apollo/server": "^5.2.0",
    "@as-integrations/express5": "^1.1.2",
    "@google/generative-ai": "^0.24.1",
    "@graphql-tools/load-files": "^7.0.1",
    "@graphql-tools/schema": "^10.0.29",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "graphql": "^16.12.0",
    "mp4box": "^2.3.0",
    "multer": "^2.0.2",
    "node-pg-migrate": "^8.0.3",
    "pg": "^8.16.3"
  },
  "overrides": {
    "glob": ">=11.1.0"
  }
}
